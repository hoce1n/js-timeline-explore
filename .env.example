# Privacy-friendly analytics — OPT-IN. Analytics stay completely disabled
# (no external script loads) until one provider is configured below.

# Plausible (recommended): set your site domain. No cookies, no accounts.
# VITE_PLAUSIBLE_DOMAIN=your-site.example.com

# Alternative: self-hosted Umami.
# VITE_UMAMI_HOST=https://analytics.example.com
# VITE_UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
